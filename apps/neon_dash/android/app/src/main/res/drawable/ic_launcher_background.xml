<?xml version="1.0" encoding="utf-8"?>
<!-- The plate the icon stands on, as a vector rather than five PNGs.
     It is a two-stop gradient; shipping it as pixels cost about 150 KB of
     the APK and bought nothing a gradient cannot say exactly.
     Colours are Palette.skyNear and Palette.skyFar. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="54"
                android:startY="0"
                android:endX="54"
                android:endY="108">
                <item android:offset="0" android:color="#FF0C1226"/>
                <item android:offset="1" android:color="#FF05070F"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
